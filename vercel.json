{
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|css|js|webp|avif|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/sitemap",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/auth",
      "destination": "/index.html"
    },
    {
      "source": "/auth/mal",
      "destination": "/index.html"
    },
    {
      "source": "/watch/:id",
      "destination": "/api/render-seo?id=:id"
    },
    {
      "source": "/watch/:id/:slug",
      "destination": "/api/render-seo?id=:id&slug=:slug"
    },
    {
      "source": "/trending",
      "destination": "/api/render-seo?path=trending"
    },
    {
      "source": "/top-rated",
      "destination": "/api/render-seo?path=top-rated"
    },
    {
      "source": "/airing",
      "destination": "/api/render-seo?path=airing"
    },
    {
      "source": "/watchlist",
      "destination": "/api/render-seo?path=watchlist"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
